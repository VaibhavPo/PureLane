{%- comment -%}
  Purelane Newsletter Signup Section
{%- endcomment -%}

<section class="sec" data-scene="4" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.subheading }}</p>

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" 
               name="contact[email]" 
               placeholder="{{ section.settings.placeholder }}" 
               aria-label="Email address" 
               required>
        <button class="btn btn-primary" type="submit">{{ section.settings.button_text }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get my ₹100 off"
    }
  ],
  "presets": [
    {
      "name": "Purelane Newsletter"
    }
  ]
}
{% endschema %}
