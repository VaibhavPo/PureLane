{%- comment -%}
  Purelane Bundles Section
{%- endcomment -%}

<section class="sec" id="bundles" data-scene="3" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
      </div>
    </div>

    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tier' -%}
          <article class="glass tier {% if block.settings.is_featured %}best{% endif %} rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag_text != blank -%}
              <span class="tag">{{ block.settings.tag_text }}</span>
            {%- endif -%}

            <div class="tierpix {% if block.settings.image_5_class != blank %}five{% endif %}" aria-hidden="true">
              {%- if block.settings.image_1_class != blank -%}
                <span class="pimg {{ block.settings.image_1_class }}" role="img"></span>
              {%- endif -%}
              {%- if block.settings.image_2_class != blank -%}
                <span class="pimg {{ block.settings.image_2_class }}" role="img"></span>
              {%- endif -%}
              {%- if block.settings.image_3_class != blank -%}
                <span class="pimg {{ block.settings.image_3_class }}" role="img"></span>
              {%- endif -%}
              {%- if block.settings.image_4_class != blank -%}
                <span class="pimg {{ block.settings.image_4_class }}" role="img"></span>
              {%- endif -%}
              {%- if block.settings.image_5_class != blank -%}
                <span class="pimg {{ block.settings.image_5_class }}" role="img"></span>
              {%- endif -%}
            </div>

            <div class="qty">{{ block.settings.quantity }}<small>{{ block.settings.quantity_unit }}</small></div>
            <div class="price">
              {{ block.settings.price }}
              {%- if block.settings.compare_at_price != blank -%}
                <s>{{ block.settings.compare_at_price }}</s>
              {%- endif -%}
            </div>
            {%- if block.settings.price_note != blank -%}
              <p class="body-s" style="font-size:12px">{{ block.settings.price_note }}</p>
            {%- endif -%}

            <ul>
              {%- if block.settings.bullet_1 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4L19 7"/>
                  </svg>
                  {{ block.settings.bullet_1 }}
                </li>
              {%- endif -%}
              {%- if block.settings.bullet_2 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4L19 7"/>
                  </svg>
                  {{ block.settings.bullet_2 }}
                </li>
              {%- endif -%}
              {%- if block.settings.bullet_3 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4L19 7"/>
                  </svg>
                  {{ block.settings.bullet_3 }}
                </li>
              {%- endif -%}
            </ul>

            <a class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">
              {{ block.settings.button_text }}
              {%- if block.settings.is_featured -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              {%- endif -%}
            </a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
