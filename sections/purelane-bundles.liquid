          "settings": {
            "tag_text": "Starter",
            "quantity": "2",
            "price": "₹349",
            "compare_at_price": "₹598",
            "price_note": "Flat ₹174 per product",
            "bullet_1": "Pick any two products",
            "bullet_2": "Free shipping across India",
            "image_1_class": "p-combo2"
