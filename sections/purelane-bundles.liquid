        },
        {
          "type": "text",
          "id": "image_1_class",
          "label": "Image 1 CSS Class",
          "default": "p-combo2"
        },
        {
          "type": "text",
          "id": "image_2_class",
          "label": "Image 2 CSS Class"
        },
        {
          "type": "text",
          "id": "image_3_class",
          "label": "Image 3 CSS Class"
        },
        {
          "type": "text",
          "id": "image_4_class",
          "label": "Image 4 CSS Class"
        },
        {
          "type": "text",
          "id": "image_5_class",
          "label": "Image 5 CSS Class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
