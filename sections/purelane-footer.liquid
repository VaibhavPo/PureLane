{%- comment -%}
  Custom Purelane Footer Section
{%- endcomment -%}

<footer data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="#top" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
              <path d="M12 21v-6"/>
            </svg>
          </span>
          <span class="txt">
            <span class="n1">{{ section.settings.brand_name }}</span>
            <span class="n2">{{ section.settings.brand_tagline }}</span>
          </span>
        </a>
        <p style="max-width:30ch">{{ section.settings.brand_bio }}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="fcol" {{ block.shopify_attributes }}>
            <h5>{{ block.settings.title }}</h5>
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- elsif block.settings.title == 'Shop' -%}
              <a href="#shop">Bestsellers</a>
              <a href="#shop">Kitchen</a>
              <a href="#shop">Laundry</a>
              <a href="#shop">Home</a>
              <a href="#shop">Skin</a>
              <a href="#bundles">Starter kits</a>
            {%- elsif block.settings.title == 'About' -%}
              <a href="#how">How it works</a>
              <a href="#ingredients">Sustainability</a>
              <a href="#reviews">FAQs</a>
              <a href="#reviews">Reviews</a>
            {%- endif -%}
          </div>
        {%- elsif block.type == 'contact_info' -%}
          <div class="fcol" {{ block.shopify_attributes }}>
            <h5>{{ block.settings.title }}</h5>
            {%- if block.settings.email != blank -%}
              <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <a href="tel:{{ block.settings.phone | replace: ' ', '' }}">{{ block.settings.phone }}</a>
            {%- endif -%}
            {%- if block.settings.address != blank -%}
              <p style="font-size:12px;color:rgba(236,230,247,.5)">{{ block.settings.address }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="fbot">
      <span>{{ section.settings.copyright_text }}</span>
      <span>
        {%- for link in section.settings.footer_bottom_links.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>{%- unless forloop.last %} · {% endunless -%}
        {%- else -%}
          Privacy · Terms · Refunds · Contact
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "text",
      "id": "brand_bio",
      "label": "Brand Bio",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 Purelane Eco Products Private Limited"
    },
    {
      "type": "link_list",
      "id": "footer_bottom_links",
      "label": "Footer Bottom Links"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link List Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact Info Column",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Get in touch"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email Address",
          "default": "hello@purelane.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone Number",
          "default": "+91 9930 123 234"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address/Company Info",
          "default": "Purelane Eco Products Pvt Ltd"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "title": "Shop"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "title": "About"
        }
      },
      {
        "type": "contact_info",
        "settings": {
          "title": "Get in touch",
          "email": "hello@purelane.com",
          "phone": "+91 9930 123 234",
          "address": "Purelane Eco Products Pvt Ltd"
        }
      }
    ]
  }
}
{% endschema %}
