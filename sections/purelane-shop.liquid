{%- comment -%}
  Purelane Shopify Product Grid

  Product metafields:
    custom.reviews_rating       -> Shopify Rating type
    custom.reviews_rating_count -> Number / Integer

  Priority:
    1. Product metafields
    2. Block fallback values / dynamic sources
{%- endcomment -%}

<section class="sec" id="shop" data-scene="3" {{ section.shopify_attributes }}>

  <div class="wrap">

    <div class="panel-head rv">

      <span class="kicker">
        {{ section.settings.kicker }}
      </span>

      <h2 class="d2" style="margin-top:12px">
        {{ section.settings.heading }}
      </h2>

      <div class="rule">

        <i></i>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <i></i>

      </div>

    </div>


    <div class="shelf" id="shopShelf">

      {%- for block in section.blocks -%}

        {%- assign product = block.settings.product -%}

        {%- if product != blank -%}

          {%- comment -%}
            ==========================================================
            RATING
            ==========================================================

            custom.reviews_rating is a Shopify Rating metafield.

            Shopify's metafield_text filter converts the Rating
            metafield into its display value.

            Example:
            4.2 out of 5.0 -> 4.2
          {%- endcomment -%}

          {%- assign rating_val = product.metafields.custom.reviews_rating | metafield_text -%}


          {%- comment -%}
            ==========================================================
            REVIEW COUNT
            ==========================================================

            custom.reviews_rating_count is an integer metafield.

            metafield_text safely converts the metafield value
            into displayable text.
          {%- endcomment -%}

          {%- assign review_count_val = product.metafields.custom.reviews_rating_count | metafield_text -%}


          {%- comment -%}
            ==========================================================
            FALLBACK
            ==========================================================
          {%- endcomment -%}

          {%- if rating_val == blank -%}
            {%- assign rating_val = block.settings.rating -%}
          {%- endif -%}

          {%- if review_count_val == blank -%}
            {%- assign review_count_val = block.settings.rating_count -%}
          {%- endif -%}


          {%- comment -%}
            ==========================================================
            PRODUCT DATA
            ==========================================================
          {%- endcomment -%}

          {%- assign product_title = product.title -%}

          {%- assign product_price = product.price -%}

          {%- assign compare_at_price = product.compare_at_price -%}

          {%- assign discount = compare_at_price | minus: product_price -%}

          {%- assign image_alt = product.featured_image.alt | default: product_title -%}

          {%- assign product_tag = product.tags.first -%}

          {%- assign variant = product.selected_or_first_available_variant -%}

          {%- assign variant_id = variant.id -%}

          {%- assign is_available = product.available -%}


          <article
            class="
              glass
              card
              rv
              {% if forloop.index == 2 %}rv-d1{% endif %}
              {% if forloop.index == 3 %}rv-d2{% endif %}
              {% if forloop.index == 4 %}rv-d3{% endif %}
              {% unless is_available %}sold-out{% endunless %}
            "
            data-name="{{ product_title | escape }}"
            data-available="{{ is_available }}"
            data-variant-id="{{ variant_id }}"
            {{ block.shopify_attributes }}
          >


            {%- comment -%}
              ==========================================================
              IMAGE
              ==========================================================
            {%- endcomment -%}

            <div class="shot">

              {%- if is_available == false -%}

                <span class="pill">
                  Sold out
                </span>

              {%- elsif product_tag != blank -%}

                <span class="pill">
                  {{ product_tag }}
                </span>

              {%- endif -%}


              {%- if product.featured_image != blank -%}

                {{
                  product.featured_image
                  | image_url: width: 500
                  | image_tag:
                    alt: image_alt,
                    loading: 'lazy'
                }}

              {%- else -%}

                <span
                  class="pimg p-tap"
                  role="img"
                  aria-label="{{ product_title | escape }}"
                ></span>

              {%- endif -%}

            </div>


            {%- comment -%}
              ==========================================================
              TITLE
              ==========================================================
            {%- endcomment -%}

            <h4>
              {{ product_title }}
            </h4>


            {%- comment -%}
              ==========================================================
              RATING / REVIEWS
              ==========================================================
            {%- endcomment -%}


            {%- if rating_val != blank or review_count_val != blank -%}
              <div class="rate">

                {%- if rating_val != blank -%}
                  <b>★ {{ rating_val }}</b>
                {%- endif -%}

                {%- if review_count_val != blank -%}
                  <span> · {{ review_count_val }} reviews</span>
                {%- endif -%}

              </div>
            {%- endif -%}


            {%- comment -%}
              ==========================================================
              PRICE
              ==========================================================
            {%- endcomment -%}

            <div class="pr">

              <strong>
                {{ product_price | money_without_trailing_zeros }}
              </strong>


              {%- if compare_at_price != blank
                and product_price != blank
                and compare_at_price > product_price
              -%}

                <s>
                  {{ compare_at_price | money_without_trailing_zeros }}
                </s>


                {%- if compare_at_price > 0 -%}

                  <em>
                    {{
                      discount
                      | times: 100.0
                      | divided_by: compare_at_price
                      | round
                    }}% off
                  </em>

                {%- endif -%}

              {%- endif -%}

            </div>


            {%- comment -%}
              ==========================================================
              CART
              ==========================================================
            {%- endcomment -%}

            {%- if is_available -%}

              <div class="card-cart-row">

                <button
                  class="btn btn-ghost btn-sm btn-atc"
                  type="button"
                  data-variant="{{ variant_id }}"
                  aria-label="Add {{ product_title | escape }} to cart"
                >
                  Add to cart
                </button>


                <div
                  class="card-qty"
                  style="display:none"
                  aria-label="Quantity in cart"
                >

                  <button
                    class="card-qty-btn"
                    type="button"
                    data-action="dec"
                    aria-label="Remove one"
                  >
                    −
                  </button>

                  <span class="card-qty-num">
                    1
                  </span>

                  <button
                    class="card-qty-btn"
                    type="button"
                    data-action="inc"
                    aria-label="Add one more"
                  >
                    +
                  </button>

                </div>

              </div>

            {%- else -%}

              <button
                class="btn btn-ghost btn-sm btn-atc"
                type="button"
                disabled
                aria-disabled="true"
              >
                Sold out
              </button>

            {%- endif -%}

          </article>

        {%- endif -%}

      {%- endfor -%}

    </div>

  </div>

</section>


{% schema %}

{
  "name": "Purelane Product Grid",

  "settings": [

    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    }

  ],

  "blocks": [

    {
      "type": "product_card",
      "name": "Product",

      "settings": [

        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },

        {
          "type": "paragraph",
          "content": "Rating is automatically loaded from custom.reviews_rating and review count from custom.reviews_rating_count. The fallback fields can be used when the product metafields are empty."
        },

        {
          "type": "text",
          "id": "rating",
          "label": "Rating fallback"
        },

        {
          "type": "text",
          "id": "rating_count",
          "label": "Review count fallback"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Purelane Product Grid",

      "blocks": [

        {
          "type": "product_card"
        },

        {
          "type": "product_card"
        },

        {
          "type": "product_card"
        },

        {
          "type": "product_card"
        }

      ]

    }

  ]

}

{% endschema %}