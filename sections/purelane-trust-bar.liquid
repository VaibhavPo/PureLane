{%- comment -%}
  Purelane Trust Bar Section
{%- endcomment -%}

<section class="sec" data-scene="4" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="glass trust rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="trust-i" {{ block.shopify_attributes }}>
            {%- if block.settings.custom_svg != blank -%}
              {{ block.settings.custom_svg }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

