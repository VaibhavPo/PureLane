{%- comment -%} Configurable three-product combo cards {%- endcomment -%}

<section class="sec" id="combos" data-scene="3" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
    </div>

    <div class="combo-rail rv">
      <div class="combo-rail-controls" aria-label="Scroll combo cards">
        <button class="combo-scroll-btn combo-prev" type="button" aria-label="Scroll left">Prev</button>
        <button class="combo-scroll-btn combo-next" type="button" aria-label="Scroll right">Next</button>
      </div>
      <div class="comborail" tabindex="0" aria-label="Best selling combo cards slider">
        {%- for block in section.blocks -%}
          {%- assign product_1 = block.settings.product_1 -%}
          {%- assign product_2 = block.settings.product_2 -%}
          {%- assign product_3 = block.settings.product_3 -%}
        {%- assign regular_price = 0 -%}
        {%- assign product_count = 0 -%}
        {%- if product_1 != blank -%}{%- assign regular_price = regular_price | plus: product_1.price -%}{%- assign product_count = product_count | plus: 1 -%}{%- endif -%}
        {%- if product_2 != blank -%}{%- assign regular_price = regular_price | plus: product_2.price -%}{%- assign product_count = product_count | plus: 1 -%}{%- endif -%}
        {%- if product_3 != blank -%}{%- assign regular_price = regular_price | plus: product_3.price -%}{%- assign product_count = product_count | plus: 1 -%}{%- endif -%}
        {%- assign special_price_cents = block.settings.special_price | times: 100 -%}
        {%- assign savings = regular_price | minus: special_price_cents -%}
        {%- if product_count > 0 -%}
          <article class="glass combo {% if block.settings.is_featured %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="tray">
              {%- if block.settings.savings_tag != blank -%}<span class="save">{{ block.settings.savings_tag }}{% if savings > 0 %} {{ savings | money_without_trailing_zeros }}{% endif %}</span>{%- endif -%}
              {%- if block.settings.badge_text != blank -%}<span class="flag">{{ block.settings.badge_text }}</span>{%- endif -%}
              <div class="stack">
                {%- if product_1 != blank -%}<span class="it">{%- if product_1.featured_image != blank -%}<img class="pimg" src="{{ product_1.featured_image | image_url: width: 200 }}" alt="{{ product_1.title | escape }}" loading="lazy">{%- endif -%}<span>{{ product_1.title }}</span></span>{%- endif -%}
                {%- if product_2 != blank -%}<span class="plus" aria-hidden="true">+</span><span class="it">{%- if product_2.featured_image != blank -%}<img class="pimg" src="{{ product_2.featured_image | image_url: width: 200 }}" alt="{{ product_2.title | escape }}" loading="lazy">{%- endif -%}<span>{{ product_2.title }}</span></span>{%- endif -%}
                {%- if product_3 != blank -%}<span class="plus" aria-hidden="true">+</span><span class="it">{%- if product_3.featured_image != blank -%}<img class="pimg" src="{{ product_3.featured_image | image_url: width: 200 }}" alt="{{ product_3.title | escape }}" loading="lazy">{%- endif -%}<span>{{ product_3.title }}</span></span>{%- endif -%}
              </div>
            </div>
            <div class="body">
              <h3>{{ block.settings.title }}</h3>
              <div class="cnt">{{ product_count }} products</div>
              {%- if block.settings.description != blank -%}<p class="inc">{{ block.settings.description }}</p>{%- endif -%}
              <div class="prow"><strong>{{ special_price_cents | money_without_trailing_zeros }}</strong><s>{{ regular_price | money_without_trailing_zeros }}</s>{%- if savings > 0 -%}<em>Save {{ savings | money_without_trailing_zeros }}</em>{%- endif -%}</div>
              {%- if block.settings.fine_print != blank -%}<div class="fine">{{ block.settings.fine_print }}</div>{%- endif -%}
              <a class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">{{ block.settings.button_text }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
      </div>
    </div>
    <div class="swipecue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos</div>
    <p class="railnote">{{ section.settings.rail_note }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "text", "id": "rail_note", "label": "Bottom rail note", "default": "Tapping Shop bundle opens the bundle picker with these products already added." }
  ],
  "blocks": [{
    "type": "combo",
    "name": "Three-product combo",
    "settings": [
      { "type": "header", "content": "Products in this combo" },
      { "type": "product", "id": "product_1", "label": "Product 1" },
      { "type": "product", "id": "product_2", "label": "Product 2" },
      { "type": "product", "id": "product_3", "label": "Product 3" },
      { "type": "header", "content": "Offer and card details" },
      { "type": "text", "id": "title", "label": "Combo title", "default": "Kitchen essentials" },
      { "type": "number", "id": "special_price", "label": "Special combo price (INR)", "default": 499, "info": "The regular price and savings are calculated automatically from the selected products." },
      { "type": "text", "id": "savings_tag", "label": "Savings tag prefix", "default": "You save" },
      { "type": "text", "id": "badge_text", "label": "Top badge", "default": "Most popular" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Includes three essentials for a sparkling kitchen, no need to pick separately." },
      { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Inclusive of all taxes · COD available" },
      { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop bundle" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "checkbox", "id": "is_featured", "label": "Highlight this combo", "default": false }
    ]
  }],
  "presets": [{ "name": "Purelane Combos", "blocks": [{ "type": "combo" }, { "type": "combo" }, { "type": "combo", "settings": { "is_featured": true, "badge_text": "Best value" } }] }]
}
{% endschema %}
