{%- comment -%}
  Purelane Categories Section
{%- endcomment -%}

<section class="sec" id="categories" data-scene="4" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>

    <div class="cats">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category_card' -%}
          <a class="glass cat rv {% if forloop.index == 2 %}rv-d1{% elsif forloop.index == 3 %}rv-d2{% elsif forloop.index == 4 %}rv-d3{% endif %}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
            <span class="ph">
              <span class="pimg {{ block.settings.image_class }}" role="img" aria-label="{{ block.settings.title }}"></span>
            </span>
            <span class="txt">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.subtitle }}</p>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "image_class",
          "label": "Image CSS Class",
          "default": "p-kitchen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Target"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "image_class": "p-kitchen",
            "title": "Kitchen bundle",
            "subtitle": "Grease, dishes & more"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "image_class": "p-toilet",
            "title": "Bathroom bundle",
            "subtitle": "Deep clean & disinfect"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "image_class": "p-laundry",
            "title": "Laundry bundle",
            "subtitle": "Softer, fresher wash"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "image_class": "p-tap",
            "title": "Hard water bundle",
            "subtitle": "Melt away limescale"
          }
        }
      ]
    }
  ]
}
{% endschema %}
