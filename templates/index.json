            "product_purchased": "Dishwash gel"
          }
        },
        "rev_3": {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "content": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_purchased": "Liquid handwash"
          }
        },
        "rev_4": {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "content": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_purchased": "Floor cleaner"
          }
        },
        "rev_5": {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
